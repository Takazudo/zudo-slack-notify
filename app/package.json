{
  "name": "zudo-slack-notify-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Authenticated Cloudflare Worker API and Node CLI that post notifications to Slack channels selected by alias.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/workerd/tsconfig.json",
    "test": "vitest run",
    "test:workerd": "node scripts/run-workerd-tests.ts",
    "notify": "node cli/notify.ts",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.1",
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.143.0"
  }
}
