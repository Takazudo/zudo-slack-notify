{
  "name": "zudo-slack-notify-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:md": "mdx-formatter --write --config .mdx-formatter.json \"**/*.{md,mdx}\"",
    "format:md:check": "mdx-formatter --check --config .mdx-formatter.json \"**/*.{md,mdx}\"",
    "b4push": "bash scripts/run-b4push.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@takazudo/mdx-formatter": "^1.3.0-next.4",
    "lefthook": "^2.1.0",
    "prettier": "^3.5.0"
  }
}
