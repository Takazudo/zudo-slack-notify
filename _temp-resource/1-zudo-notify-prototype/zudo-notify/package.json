{
  "name": "zudo-notify-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiny authenticated Cloudflare Worker notification API for local AI agents.",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "test:workerd": "pnpm build && node tests/workerd-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "notify": "node cli/notify.ts",
    "preview": "node scripts/preview-server.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "miniflare": "4.20260424.0",
    "typescript": "5.9.3",
    "wrangler": "4.85.0"
  }
}
